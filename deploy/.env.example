# Copy to .env for docker-compose.suban.yml interpolation.
# Never commit .env.

# Cloudflare tunnel token. Required only when starting the cloudflared service
# and using the public hostnames. Leave blank for a local-only run.
TUNNEL_TOKEN=

# Arc testnet values. Optional; leave blank for a Pi-only run.
ARC_RPC_URL=
ARC_CHAIN_ID=
ARC_NETWORK_NAME=Arc
ARC_PRICE_PAIR_ADDRESS=
WEIGHT_ARC=1.5
