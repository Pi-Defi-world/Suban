# Suban Data Platform (event-indexer) environment
# Copy to .env and fill deployment-specific values. Never commit .env.

# ── Network ──────────────────────────────────────────────────────────
PI_SOROBAN_RPC_URL=http://localhost:8000
PI_NETWORK_PASSPHRASE=Pi Testnet
# Horizon is required for ledger/transaction/operation/account ingestion.
# Local Pi node examples: http://localhost:41401 (mainnet), http://localhost:31401 (testnet)
HORIZON_URL=http://localhost:41401

# ── Storage and loop ─────────────────────────────────────────────────
INDEXER_DB_PATH=./events.db
INDEXER_POLL_MS=10000
INDEXER_API_PORT=3002

# ── Bootstrap / backfill ─────────────────────────────────────────────
# On first start with no checkpoint, start this many ledgers behind the tip.
INDEXER_EVENT_BOOTSTRAP_LEDGERS=1000
# 0 = current Horizon tip. Increase deliberately for a historical backfill.
INDEXER_HORIZON_BOOTSTRAP_LEDGERS=0
INDEXER_MAX_LEDGERS_PER_POLL=25
INDEXER_FETCH_ACCOUNT_SNAPSHOTS=true
INDEXER_ACCOUNT_FETCH_LIMIT=10

# ── Freshness / alerts ───────────────────────────────────────────────
INDEXER_STALE_AFTER_SECONDS=120
INDEXER_MAX_LAG_LEDGERS=10

# ── Contract registry ───────────────────────────────────────────────
# Set only the contracts this deployment indexes.
POOL_FACTORY_CONTRACT_ID=
CPMM_POOL_CONTRACT_ID=
STABLESWAP_CONTRACT_ID=
LENDING_POOL_CONTRACT_ID=
BACKSTOP_CONTRACT_ID=
ESCROW_CONTRACT_ID=
ORACLE_CONTRACT_ID=
BRIDGE_MULTISIG_CONTRACT_ID=
EVENT_REGISTRY_CONTRACT_ID=
NODE_STAKING_CONTRACT_ID=
IDENTITY_CONTRACT_ID=
# Names listed here are marked verified in the metadata registry. This is a
# deployment assertion, not source-code verification.
INDEXER_VERIFIED_CONTRACTS=

# Optional full override for registry/ingestion (JSON array).
# INDEXER_CONTRACTS_JSON=[{"name":"pool-factory","contractId":"C...","interfaceVersion":"1.0.0","verified":false}]

# Financial valuation (optional). Without these, USD fields stay null and the
# valuation route returns 503 instead of inferring a price or decimals.
# INDEXER_PRICE_API_URL=http://localhost:3000/api/v1
# JSON map: token contract ID -> controller asset ID
# INDEXER_TOKEN_ASSETS={"C...":"PI","C...":"USDC"}
# JSON map: token contract ID -> integer decimals
# INDEXER_TOKEN_DECIMALS={"C...":7,"C...":7}

# ── Public API keys / quotas ────────────────────────────────────────
INDEXER_REQUIRE_API_KEY=true
# JSON or key:name:perMinute:perDay
INDEXER_API_KEYS='key-one:demo:60:10000'
# Admin routes return 503 when this is unset.
INDEXER_ADMIN_API_KEY=

# ── Webhooks ─────────────────────────────────────────────────────────
INDEXER_WEBHOOK_INTERVAL_MS=5000
INDEXER_WEBHOOK_MAX_ATTEMPTS=8
INDEXER_WEBHOOK_BASE_BACKOFF_MS=1000
INDEXER_WEBHOOK_MAX_BACKOFF_MS=300000
INDEXER_WEBHOOK_TIMEOUT_MS=5000
