# Liquidation bot configuration. Never commit a filled copy.
# The bot is dry-run by default. Set LIQUIDATION_EXECUTE=true only after a
# manual review and only with a dedicated, low-balance testnet key.

LENDING_POOL_CONTRACT_ID=
STELLAR_RPC_URL=https://rpc.testnet.minepi.com
STELLAR_NETWORK_PASSPHRASE=Pi Testnet
# Pi testnet currently needs a higher inclusion fee than the SDK default.
STELLAR_TX_FEE=2000000

# One of: dry-run | execute
LIQUIDATION_MODE=dry-run
# Required in execute mode. Use a dedicated liquidator key, not the deployer.
LIQUIDATOR_SECRET=
# Required in dry-run mode (and optional in execute mode when a secret exists).
LIQUIDATOR_PUBLIC_KEY=

# Comma-separated accounts to inspect. If empty, DATA_PLATFORM_URL is queried.
LIQUIDATION_ACCOUNTS=
DATA_PLATFORM_URL=

LIQUIDATION_MAX_REPAY_RAW=1000000000
LIQUIDATION_MIN_HEALTH_BPS=10000
LIQUIDATION_BONUS_BPS=500
LIQUIDATION_SLIPPAGE_BPS=100
LIQUIDATION_POLL_MS=300000
LIQUIDATION_MAX_CANDIDATES=100
