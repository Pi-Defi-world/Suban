{
  "name": "@suban/liquidation-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Testnet liquidation bot prototype. Dry-run by default; execution requires an explicit opt-in.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
